{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/vue-tsc/node_modules/@types",
      "./node_modules/app-vite/@types"
    ],
  },
  "exclude": [
    "./dist",
    "./.quasar",
    "./node_modules",
    "./src-cordova",
    "./quasar.config.*.temporary.compiled*"
  ]
}